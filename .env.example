# Frontend
VITE_API_BASE_URL=https://<document-service-fqdn>

# Document Service
ConnectionStrings__Postgres=Host=<host>;Port=5432;Database=pls;Username=pls;Password=<password>
SummarizationService__BaseUrl=http://pls-summarization-service
LocalStorage__BasePath=/data/storage

# Orchestrator Service
ConnectionStrings__Postgres=Host=<host>;Port=5432;Database=pls;Username=pls;Password=<password>
SummarizationService__BaseUrl=http://pls-summarization-service

# Summarization Service (Azure OpenAI)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_KEY=<key>
AZURE_OPENAI_DEPLOYMENT_PROMPT=<deployment>
AZURE_OPENAI_DEPLOYMENT_FINETUNE=<deployment>
AZURE_OPENAI_DEPLOYMENT_AGENT=<deployment>
AZURE_OPENAI_DEPLOYMENT_IMAGE=<deployment>

# Optional: Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest
